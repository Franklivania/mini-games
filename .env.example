# Copy to .env for local dev (`npm run dev` / `npm run check:groq`). Never commit .env.
# In production set these in Netlify: Site configuration → Environment variables (scope: Functions).
GROQ_API_KEY=

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
# GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-22m
